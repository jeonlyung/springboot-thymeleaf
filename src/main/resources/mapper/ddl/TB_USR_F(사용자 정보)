CREATE TABLE `TB_USR_F` (
  `USR_ID`      VARCHAR(50)  NOT NULL COMMENT '사용자 아이디',
  `USR_PW`      VARCHAR(255) DEFAULT NULL COMMENT '비밀번호(암호화) - OAuth2 로그인 시 NULL',
  `USR_NM`      VARCHAR(50)  NOT NULL COMMENT '사용자 이름',
  `PET_NM`      VARCHAR(50)  DEFAULT NULL COMMENT '반려견 이름',
  `DOG_BREED`   VARCHAR(50)  DEFAULT NULL COMMENT '견종',
  `PROFILE_IMG` VARCHAR(500) DEFAULT NULL COMMENT '프로필 이미지 경로',
  `PROVIDER`    VARCHAR(20)  DEFAULT NULL COMMENT 'OAuth2 제공자(google, kakao, naver)',
  `PROVIDER_ID` VARCHAR(100) DEFAULT NULL COMMENT 'OAuth2 제공자별 고유 ID',
  `USE_YN`      CHAR(1)      DEFAULT 'Y'  COMMENT '사용 여부(Y/N)',
  `FST_REG_DTM` DATETIME     DEFAULT CURRENT_TIMESTAMP COMMENT '최초 등록 일시',
  `FST_REG_ID`  VARCHAR(50)  DEFAULT 'SYSTEM' COMMENT '최초 등록자',
  `LST_CHG_DTM` DATETIME     DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '최종 수정 일시',
  `LST_CHG_ID`  VARCHAR(50)  DEFAULT 'SYSTEM' COMMENT '최종 수정자',
  PRIMARY KEY (`USR_ID`),
  UNIQUE KEY `UK_PROVIDER` (`PROVIDER`, `PROVIDER_ID`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;